{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Ultracite 7 exports Biome presets under `ultracite/biome/*` only. The
  // original list ("ultracite", "ultracite/core", "ultracite/react",
  // "ultracite/next") named the *oxlint* presets, which have no Biome export,
  // so every Biome run died on "Could not resolve ultracite".
  //
  // These presets also require Biome >= 2.5 — on 2.3.x they fail with unknown
  // keys (`useSortedEnumMembers`, `noDuplicateClasses`). Keep `@biomejs/biome`
  // at 2.5.x or newer in the root package.json.
  //
  // `next` is dropped: the only Next app, apps/web-next, is excluded below and
  // carries its own nested config.
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  // Root Biome covers only what no app owns: root config files, apps/studio,
  // and packages/*.
  //
  // - apps/web is formatted by Oxfmt/Oxlint (apps/web/oxfmt.config.ts). Letting
  //   Biome format it too would have the two formatters rewrite each other.
  // - apps/web-next ships its own biome.jsonc and is excluded from workspaces,
  //   so its dependencies are not installed.
  // - tools/oxlint/anti-slop is vendored from upstream
  //   (github.com/dmmulroy/anti-slop). Reformatting it would make every future
  //   sync from upstream conflict; keep it byte-identical to its source.
  // `!!` is force-ignore: a plain `!` exclusion is not enough, because
  // apps/web-next has its own nested biome.jsonc, and a nested config governs
  // its own directory regardless of what the root config excludes. Force-ignore
  // stops the scanner descending at all.
  "files": {
    "includes": [
      "**",
      "!!apps/web/**",
      "!!apps/web-next/**",
      "!!tools/oxlint/anti-slop/**"
    ]
  }
}
