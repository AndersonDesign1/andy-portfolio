---
import { ArrowLeft01Icon, Refresh01Icon } from "@hugeicons/core-free-icons";
import { HugeiconsIcon } from "@hugeicons/react";
import { interpretError } from "../lib/errors";

interface Props {
  /** Override the interpreted description for this specific page. */
  description?: string;
  /** Show the requested path and a "did you mean" hint (404-style pages). */
  showPath?: boolean;
  status: number;
}

const { status, description, showPath = false } = Astro.props;
const error = interpretError(status);
const digits = [...String(status)];
const isServerError = error.tone === "server";

const quickLinks = [
  { href: "/projects", label: "Portfolio" },
  { href: "/blog", label: "Blog" },
  { href: "/about", label: "About" },
  { href: "/contact", label: "Contact" },
];

const actionClass =
  "group border-subtle text-primary hover:border-primary hover:bg-secondary/50 focus-visible:ring-foreground focus-visible:ring-offset-background inline-flex touch-manipulation items-center gap-2 rounded-sm border px-8 py-4 text-base font-medium transition-transform duration-200 ease-[var(--ease-out)] hover:backdrop-blur-sm focus-visible:ring-2 focus-visible:ring-offset-2 focus-visible:outline-none active:scale-[0.96] motion-reduce:active:scale-100";
---

<section class="bg-primary relative flex min-h-[85vh] items-end pt-40 pb-20 md:pt-48 md:pb-32">
  <div class="mx-auto w-full max-w-screen-lg px-6 md:px-12">
    <div class="flex flex-col gap-16">
     <div class="flex flex-col gap-8">
      <p
        aria-hidden="true"
        class="hero-title text-primary -ml-[0.05em] text-[7rem] leading-[0.9] font-bold tracking-tighter select-none md:text-[12rem] lg:text-[16rem]"
      >
        {
          digits.map((digit, index) => (
            <span class={index === 1 ? "text-muted" : undefined}>{digit}</span>
          ))
        }
      </p>

      <div class="flex flex-col justify-between gap-12 pt-4 md:flex-row md:items-end md:pt-8">
        <div class="hero-subtitle flex max-w-md flex-col gap-6">
          <div class="flex flex-col gap-4">
            <h1 class="text-primary text-3xl leading-tight font-bold tracking-tighter md:text-4xl">
              {error.title}
            </h1>
            <p class="text-secondary text-lg leading-relaxed md:text-xl">
              {description ?? error.description}
            </p>
          </div>

          {
            showPath && (
              <div
                class="hidden flex-col gap-2 font-mono text-xs"
                data-error-path
              >
                <p class="text-secondary tracking-widest uppercase">
                  Requested
                </p>
                <p class="text-primary break-all" data-error-path-value></p>
                <p class="text-secondary hidden" data-error-suggestion>
                  Did you mean{" "}
                  <a
                    class="text-primary relative touch-manipulation underline underline-offset-4 before:absolute before:-inset-x-2 before:-inset-y-4 hover:opacity-70"
                    data-error-suggestion-link
                    href="/"
                  />
                </p>
              </div>
            )
          }
        </div>

        <div class="flex flex-wrap gap-4">
          <a class={actionClass} href="/">
            <HugeiconsIcon
              className="text-muted group-hover:text-primary"
              color="currentColor"
              icon={ArrowLeft01Icon}
              size={16}
              strokeWidth={1.5}
            />
            Back home
          </a>
          {
            isServerError && (
              <button class={actionClass} data-error-reload type="button">
                <HugeiconsIcon
                  className="text-muted group-hover:text-primary"
                  color="currentColor"
                  icon={Refresh01Icon}
                  size={16}
                  strokeWidth={1.5}
                />
                Try again
              </button>
            )
          }
        </div>
      </div>
     </div>

      <nav
        aria-label="Other pages"
        class="border-subtle flex flex-wrap items-center gap-x-8 border-t pt-8 font-mono text-xs tracking-widest uppercase"
      >
        <span class="text-muted inline-flex min-h-11 items-center">Try instead</span>
        {
          quickLinks.map(({ href, label }) => (
            <a
              class="text-secondary hover:text-primary inline-flex min-h-11 touch-manipulation items-center transition-colors duration-200"
              href={href}
            >
              {label}
            </a>
          ))
        }
      </nav>
    </div>
  </div>
</section>

<script>
  // Page → closest real route, so a typo'd or retired URL still gets somewhere.
  const ROUTES = ["/about", "/projects", "/blog", "/contact"];
  const ALIASES = {
    articles: "/blog",
    cv: "/about",
    email: "/contact",
    hire: "/contact",
    portfolio: "/projects",
    posts: "/blog",
    resume: "/about",
    work: "/projects",
  } satisfies Record<string, string>;

  const isAlias = (segment: string): segment is keyof typeof ALIASES =>
    Object.hasOwn(ALIASES, segment);

  const distance = (a: string, b: string) => {
    let previous = Array.from({ length: b.length + 1 }, (_, i) => i);
    for (let i = 1; i <= a.length; i += 1) {
      const current = [i];
      for (let j = 1; j <= b.length; j += 1) {
        const cost = a[i - 1] === b[j - 1] ? 0 : 1;
        current[j] = Math.min(
          (previous[j] ?? 0) + 1,
          (current[j - 1] ?? 0) + 1,
          (previous[j - 1] ?? 0) + cost
        );
      }
      previous = current;
    }
    return previous[b.length] ?? 0;
  };

  const suggest = (pathname: string) => {
    const segment = pathname.split("/").find(Boolean)?.toLowerCase();
    if (!segment) {
      return null;
    }
    if (isAlias(segment)) {
      return ALIASES[segment];
    }

    let best: { route: string; score: number } | null = null;
    for (const route of ROUTES) {
      const score = distance(segment, route.slice(1));
      const limit = Math.max(2, Math.floor((route.length - 1) / 3));
      if (score <= limit && (!best || score < best.score)) {
        best = { route, score };
      }
    }
    return best?.route ?? null;
  };

  const init = () => {
    const panel = document.querySelector<HTMLElement>("[data-error-path]");
    if (panel && panel.dataset.ready !== "true") {
      panel.dataset.ready = "true";
      const { pathname, search } = window.location;
      const value = panel.querySelector("[data-error-path-value]");
      if (value) {
        value.textContent = `${pathname}${search}`;
      }
      panel.classList.remove("hidden");
      panel.classList.add("flex");

      const suggestion = suggest(pathname);
      const wrapper = panel.querySelector<HTMLElement>(
        "[data-error-suggestion]"
      );
      const link = panel.querySelector<HTMLAnchorElement>(
        "[data-error-suggestion-link]"
      );
      if (suggestion && wrapper && link) {
        link.href = suggestion;
        link.textContent = suggestion;
        wrapper.classList.remove("hidden");
      }
    }

    const reload = document.querySelector<HTMLButtonElement>(
      "[data-error-reload]"
    );
    if (reload && reload.dataset.ready !== "true") {
      reload.dataset.ready = "true";
      reload.addEventListener("click", () => window.location.reload());
    }
  };

  init();
  document.addEventListener("astro:page-load", init);
</script>
