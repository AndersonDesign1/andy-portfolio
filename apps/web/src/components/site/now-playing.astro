---
/**
 * One quiet piece under the hero: what Anderson is playing on Spotify, or
 * played last. Filled in by scripts/site.ts from /api/spotify/now-playing;
 * stays hidden if Spotify has nothing or fails. Shows the album sleeve with a
 * vinyl record peeking out—tucked in when idle, sliding out and spinning while
 * a song is playing.
 */
---

<p class="np" data-now-playing data-state="loading" hidden>
  <a
    aria-label="Open track on Spotify"
    class="np-record"
    data-np-link
    href="https://open.spotify.com"
    rel="noopener"
    target="_blank"
  >
    <span aria-hidden="true" class="sleeve">
      <img alt="" class="art" data-np-art decoding="async" height="60" loading="lazy" width="60" />
    </span>
    <span aria-hidden="true" class="disc-slide">
      <span class="disc">
        <img alt="" class="label" data-np-art decoding="async" height="22" loading="lazy" width="22" />
      </span>
    </span>
  </a>
  <span class="np-text">
    <span class="np-state">
      <span data-np-label>Last played</span>
      <span aria-hidden="true" class="eq"><i></i><i></i><i></i></span>
    </span>
    <span class="np-song">
      <a data-np-link href="https://open.spotify.com" rel="noopener" target="_blank"><b data-np-track></b></a>
      {" "}by <span data-np-artist></span>
    </span>
  </span>
</p>
