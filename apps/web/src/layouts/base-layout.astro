---
import Analytics from "@vercel/analytics/astro";
import SpeedInsights from "@vercel/speed-insights/astro";
import { ClientRouter } from "astro:transitions";
import "@fontsource-variable/inter/wght.css";
import BotIdInit from "../components/botid-init.tsx";
import AskPill from "../components/site/ask-pill.astro";
import SiteFooter from "../components/site/site-footer.astro";
import SiteHeader from "../components/site/site-header.astro";
import { buildPageMeta } from "../lib/seo";
import type { OgVariant } from "../lib/seo";
import "../styles/global.css";
import "../styles/site.css";

interface Props {
  description?: string;
  /** Shrink the layout (not overlay it) when the phone keyboard opens: full-screen tools like /ai. */
  keyboardResizes?: boolean;
  noindex?: boolean;
  og?: OgVariant;
  title?: string;
}

const {
  title,
  description,
  keyboardResizes = false,
  noindex = false,
  og,
} = Astro.props;

const viewport = `width=device-width, initial-scale=1, viewport-fit=cover${
  keyboardResizes ? ", interactive-widget=resizes-content" : ""
}`;

const meta = buildPageMeta({ description, og, title });
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const { pathname } = Astro.url;

/** Full-screen tool pages: no footer and no Ask pill. */
const focus = /^\/ai\/?$/u.test(pathname);
const hideCta = /^\/contact\/?$/u.test(pathname);
---

<!doctype html>
<html lang="en" transition:name="root" transition:animate="fade">
  <head>
    <meta charset="UTF-8">
    <meta content={viewport} name="viewport">
    <meta content={Astro.generator} name="generator">
    <title>{meta.title}</title>
    <meta content={meta.description} name="description">
    {noindex && <meta content="noindex" name="robots">}
    {!noindex && <link href={canonical} rel="canonical">}
    <link href="/favicon.ico" rel="icon" sizes="any" type="image/x-icon">
    <link href="/favicon.ico" rel="shortcut icon" type="image/x-icon">
    <meta content={meta.title} property="og:title">
    <meta content={meta.description} property="og:description">
    <meta content={meta.ogImage} property="og:image">
    <meta content="1200" property="og:image:width">
    <meta content="630" property="og:image:height">
    <meta content={meta.title} property="og:image:alt">
    <meta content="website" property="og:type">
    <meta content={canonical} property="og:url">
    <meta content="Anderson Joseph" property="og:site_name">
    <meta content="summary_large_image" name="twitter:card">
    <meta content={meta.title} name="twitter:title">
    <meta content={meta.description} name="twitter:description">
    <meta content={meta.ogImage} name="twitter:image">
    <slot name="head" />
    <ClientRouter />
    <script is:inline>
      (() => {
        const darkScheme = window.matchMedia("(prefers-color-scheme: dark)");

        const calm = window.matchMedia("(prefers-reduced-motion: reduce)");

        const apply = (root) => {
          root.classList.toggle("motion", !calm.matches);

          try {
            const t = localStorage.getItem("andy-theme");
            const d = t === "dark" || ((!t || t === "system") && darkScheme.matches);

            root.classList.remove("light", "dark");
            root.classList.add(d ? "dark" : "light");
          } catch {
            // Theme initialization must not block first paint.
          }
        };

        apply(document.documentElement);
        // View transitions swap in the next page's <html>: theme it before it paints.
        document.addEventListener("astro:before-swap", (event) =>
          apply(event.newDocument.documentElement)
        );
      })();
    </script>
  </head>
  <body
    class="site font-sans antialiased"
    style="font-family: 'Inter Variable', ui-sans-serif, system-ui, sans-serif;"
  >
    <a
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50"
      href="#content"
    >
      Skip to content
    </a>
    <BotIdInit client:load />
    <SiteHeader pathname={pathname} />
    <main id="content" tabindex="-1" transition:animate="fade">
      <slot />
    </main>
    {!focus && <SiteFooter hideCta={hideCta} />}
    {!focus && <AskPill />}
    <Analytics />
    <SpeedInsights />
    <script>
      import "../scripts/site.ts";
    </script>
  </body>
</html>
