---
import { SharedChat } from "../../../components/ai/shared-chat.tsx";
import BaseLayout from "../../../layouts/base-layout.astro";
import { getDatabaseEnv } from "../../../lib/env";
import { getShare } from "../../../lib/tutor-share";
import type { SharedChat as Shared } from "../../../lib/tutor-share";
import { getTutorStore } from "../../../lib/tutor-store";

export const prerender = false;

let share: Shared | undefined;

try {
  share = await getShare(
    getTutorStore(getDatabaseEnv().DATABASE_URL),
    Astro.params.id ?? ""
  );
} catch (error) {
  console.error("[share] couldn't load", error);
}

if (!share) {
  Astro.response.status = 404;
}

// Each share is someone's own chat: never cached by the CDN, never indexed.
Astro.response.headers.set("Cache-Control", "private, no-store");

const expires = share
  ? new Intl.DateTimeFormat("en", {
      dateStyle: "medium",
      timeStyle: "short",
      timeZone: "UTC",
    }).format(new Date(share.expiresAt))
  : "";
---

<BaseLayout
  description="A conversation with Andy's AI, Anderson Joseph's assistant for SEO, code, the web and AI."
  noindex
  title="A shared chat with Andy's AI"
>
  <section class="mx-auto w-full max-w-screen-md px-4 pt-28 pb-8 sm:px-6 md:px-12">
    {
      share ? (
        <>
          <header class="mb-8 flex flex-col gap-2">
            <p class="text-muted text-xs font-medium tracking-wide uppercase">
              Shared chat
            </p>
            <h1 class="text-primary text-3xl font-bold tracking-tighter md:text-4xl">
              A chat with Andy&apos;s AI
            </h1>
            <p class="text-muted text-sm">
              This link stops working on {expires} UTC.
            </p>
          </header>
          <SharedChat client:only="react" messages={share.messages} />
        </>
      ) : (
        <div class="flex min-h-[50dvh] flex-col items-center justify-center gap-4 text-center">
          <h1 class="text-primary text-3xl font-bold tracking-tighter md:text-4xl">
            This shared chat has expired
          </h1>
          <p class="text-secondary max-w-md">
            Shared chats last 24 hours. You can still ask Andy&apos;s AI
            anything yourself.
          </p>
          <a
            class="bg-foreground text-background inline-flex min-h-11 items-center rounded-full px-5 text-sm font-medium"
            href="/ai"
          >
            Ask Andy&apos;s AI
          </a>
        </div>
      )
    }
  </section>
</BaseLayout>
