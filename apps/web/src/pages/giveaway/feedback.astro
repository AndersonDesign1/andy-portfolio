---
import BaseLayout from "../../layouts/base-layout.astro";
---

<BaseLayout title="Giveaway Feedback">
  <section class="min-h-screen bg-primary px-6 pt-40 pb-24 md:px-12">
    <div class="mx-auto max-w-screen-md">
      <h1 class="mb-4 font-mono text-sm uppercase tracking-widest text-primary">
        Feedback
      </h1>
      <p class="text-secondary">
        Thanks for your interest. The giveaway has ended.
      </p>
    </div>
  </section>
</BaseLayout>
