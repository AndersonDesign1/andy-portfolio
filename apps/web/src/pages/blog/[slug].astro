---
import { client } from "@andy-portfolio/sanity-config";
import BlogPost from "../../components/blogpost.tsx";
import type { SanityPost } from "../../components/blogpost.tsx";
import BaseLayout from "../../layouts/base-layout.astro";

export const prerender = true;

export const getStaticPaths = async () => {
  try {
    const posts = await client.fetch<SanityPost[]>(
      `*[_type == "post" && defined(slug.current)]{
        _id, title, slug, excerpt, body, _createdAt, publishedAt,
        mainImage{ asset->, alt, caption },
        categories[]->{ _id, title, slug, description }
      }`
    );
    return posts.map((post) => ({
      params: { slug: post.slug.current },
      props: { post },
    }));
  } catch {
    return [];
  }
};

interface Props {
  post: SanityPost;
}

const { post } = Astro.props;
---

<BaseLayout
  description={post.excerpt || "Read this blog post"}
  title={post.title}
>
  <BlogPost post={post} client:visible />
</BaseLayout>
