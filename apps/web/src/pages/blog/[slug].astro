---
import { getEntry, render } from "astro:content";
import { ArrowLeft01Icon, ArrowRight01Icon } from "@hugeicons/core-free-icons";
import { blogMdxComponents } from "../../components/blog-mdx.tsx";
import Icon from "../../components/site/icon.astro";
import BaseLayout from "../../layouts/base-layout.astro";
import { getGraft } from "../../lib/graft";

export const prerender = true;

export const getStaticPaths = async () => {
  const posts = await getGraft().listContent("posts");

  return posts.map((post) => ({
    params: { slug: post.slug },
  }));
};

const WORDS_PER_MINUTE = 230;

const { slug } = Astro.params;
const graft = getGraft();
const post = slug ? await graft.getContent("posts", slug) : null;
const entry = slug ? await getEntry("posts", slug) : undefined;

if (!(post && entry && slug)) {
  throw new Error(
    `Blog post "${slug ?? "(missing slug)"}" is missing from the Graft index or the Astro content collection.`
  );
}

const { Content } = await render(entry);

const { categories, excerpt, mainImage, publishedAt, seoDescription, seoTitle, title } =
  post.data;

const displayDate = new Date(publishedAt).toLocaleDateString("en-US", {
  day: "numeric",
  month: "long",
  timeZone: "Africa/Lagos",
  year: "numeric",
});

const words = (entry.body ?? "").split(/\s+/u).filter(Boolean).length;
const minutes = Math.max(1, Math.round(words / WORDS_PER_MINUTE));

// The next post to read: the one after this, or the newest when this is the last.
const allPosts = await graft.listContent("posts");

const others = allPosts.toSorted(
  (left, right) =>
    Date.parse(right.data.publishedAt) - Date.parse(left.data.publishedAt)
);

const at = others.findIndex((other) => other.slug === slug);
const next = others.length > 1 ? others[(at + 1) % others.length] : undefined;
---

<BaseLayout
  description={seoDescription || excerpt || "Read this blog post"}
  og={{ kind: "blog", title }}
  title={seoTitle || title}
>
  <article class="wrap">
    <a class="cs-back" href="/blog"><span class="arr"><Icon icon={ArrowLeft01Icon} /></span> All my writing</a>
    <header class="cs-head field12">
      <h1>{title}</h1>
      {excerpt && <p class="ov">{excerpt}</p>}
      <div class="cs-meta">
        <time datetime={publishedAt}>{displayDate}</time>
        <span>{minutes} min read</span>
        {categories && categories.length > 0 && <span>{categories.join(", ")}</span>}
      </div>
    </header>

    {
      mainImage && (
        <figure class="post-fig">
          <img
            alt={mainImage.alt || title}
            height={600}
            src={mainImage.src}
            width={1200}
          />
          {mainImage.caption && <figcaption>{mainImage.caption}</figcaption>}
        </figure>
      )
    }

    <div class="prose">
      <Content components={blogMdxComponents} />
    </div>

    {
      next && (
        <a class="cs-next" href={`/blog/${next.slug}`}>
          <span class="small">Read next</span>
          <b>
            {next.data.title}
            <span class="arr"><Icon icon={ArrowRight01Icon} /></span>
          </b>
        </a>
      )
    }
  </article>
</BaseLayout>
