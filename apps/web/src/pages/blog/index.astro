---
import { getGraft } from "../../lib/graft";
import BlogList from "../../components/bloglist.tsx";
import BaseLayout from "../../layouts/base-layout.astro";

export const prerender = true;

const graft = getGraft();
const documents = await graft.listContent("posts");
const posts = documents
  .map((document) => ({
    excerpt: document.data.excerpt,
    publishedAt: document.data.publishedAt,
    slug: document.slug,
    title: document.data.title,
  }))
  .toSorted(
    (left, right) =>
      Date.parse(right.publishedAt) - Date.parse(left.publishedAt)
  );
---

<BaseLayout
  description="Thoughts on web development, SEO strategies, and lessons learned from building digital products."
  title="Blog"
>
  <BlogList posts={posts} client:visible />
</BaseLayout>
