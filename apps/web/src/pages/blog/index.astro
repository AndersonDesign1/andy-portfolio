---
import BaseLayout from "../../layouts/base-layout.astro";
import { getGraft } from "../../lib/graft";

export const prerender = true;

const documents = await getGraft().listContent("posts");

const monthYear = new Intl.DateTimeFormat("en-US", {
  month: "short",
  timeZone: "Africa/Lagos",
  year: "numeric",
});

const posts = documents
  .map((document) => ({
    date: monthYear.format(new Date(document.data.publishedAt)),
    excerpt: document.data.excerpt,
    publishedAt: document.data.publishedAt,
    slug: document.slug,
    title: document.data.title,
  }))
  .toSorted(
    (left, right) =>
      Date.parse(right.publishedAt) - Date.parse(left.publishedAt)
  );
---

<BaseLayout
  description="Anderson Joseph writes about what he builds, how it went, and what he learned along the way."
  title="Blog"
>
  <div class="wrap">
    <div class="head field12">
      <h1>Things I've written</h1>
      <p>
        Notes on tools I've built, sites I've rebuilt, and things that annoyed
        me enough to write about.
      </p>
    </div>
    <div class="posts">
      {
        posts.map((post) => (
          <a class="prow" href={`/blog/${post.slug}`}>
            <h2>{post.title}</h2>
            <span class="d">
              <time datetime={post.publishedAt}>{post.date}</time>
            </span>
            {post.excerpt && <p>{post.excerpt}</p>}
          </a>
        ))
      }
    </div>
  </div>
</BaseLayout>
