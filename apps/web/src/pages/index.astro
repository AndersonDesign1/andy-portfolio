---
import { ArrowRight01Icon, ArrowUpRight01Icon } from "@hugeicons/core-free-icons";
import Icon from "../components/site/icon.astro";
import CopyEmail from "../components/site/copy-email.astro";
import NowPlaying from "../components/site/now-playing.astro";
import WorkFigure from "../components/site/work-figure.astro";
import { EDUCATION, FEATURED_WORK, WORK_HISTORY } from "../data/work";
import BaseLayout from "../layouts/base-layout.astro";
import { RESUME_URL } from "../lib/site";

export const prerender = true;

const external = (href: string) => href.startsWith("http");
---

<BaseLayout og={{ kind: "home" }}>
  <div class="wrap">
    <div class="hero field12">
      <h1>I design and build interfaces and products people enjoy.</h1>
      <p class="lede">
        I'm Anderson, and I work from Nigeria. I care how it feels to use, how
        it's built, and whether people can find it. I'm taking on new work.
      </p>
      <div class="actions">
        <CopyEmail showAddress />
        <a class="go" href={RESUME_URL} rel="noopener" target="_blank"
          ><span class="u">My resume</span> <span class="arr"><Icon icon={ArrowUpRight01Icon} /></span></a
        >
      </div>
      <NowPlaying />
    </div>
  </div>

  <section aria-label="Selected work" class="sec">
    <div class="wrap">
      <div class="story" data-story style={`--n: ${FEATURED_WORK.length}`}>
        <div class="story-pin">
          {
            FEATURED_WORK.map((work, index) => (
              <a
                class="story-item"
                href={work.href}
                rel={external(work.href) ? "noopener" : undefined}
                target={external(work.href) ? "_blank" : undefined}
              >
                <div class="story-text">
                  <div class="top">
                    <h2>{work.title}</h2>
                    <span class="y">{work.year}</span>
                  </div>
                  <p set:html={work.outcome} />
                  <span class="small">{work.stack}</span>
                  <span class="go">
                    <span class="u">{work.go}</span>{" "}
                    <span class="arr">{external(work.href) ? <Icon icon={ArrowUpRight01Icon} /> : <Icon icon={ArrowRight01Icon} />}</span>
                  </span>
                </div>
                <WorkFigure eager={index === 0} work={work} />
              </a>
            ))
          }
        </div>
      </div>
      <div class="story-after">
        <a class="go" href="/projects"
          ><span class="u">Everything I've worked on</span> <span class="arr"><Icon icon={ArrowRight01Icon} /></span></a
        >
      </div>
    </div>
  </section>

  <section aria-label="What I do" class="sec">
    <div class="wrap">
      <div class="says field12">
        <p class="big">Most of my work sits in three places.</p>
        <div class="prs">
          <div class="pr">
            <h3>How it feels</h3>
            <p>
              Interfaces that feel right in the hand, with the layout, type and
              motion built in code, not handed off.
            </p>
          </div>
          <div class="pr">
            <h3>What's underneath</h3>
            <p>
              The product behind the screen, from the data model to the checkout,
              built with the same care at both ends.
            </p>
          </div>
          <div class="pr">
            <h3>Getting found</h3>
            <p>
              Speed and search go in from the first commit, so people can actually
              find what I build.
            </p>
          </div>
        </div>
        <p class="small">
          Mostly React, Next.js, Astro, TypeScript, Tailwind and Motion, with
          Sanity, Convex or Postgres behind them, and Search Console open in
          another tab.
        </p>
      </div>
    </div>
  </section>

  <section aria-label="Experience and education" class="sec">
    <div class="wrap">
      <div class="lists field12">
        <div class="list exp">
          <p class="lead">Where I've worked</p>
          <ul>
            {
              WORK_HISTORY.map((item) => (
                <li>
                  <b>{item.name}</b>
                  <span class="d">{item.when}</span>
                  <span class="r">{item.note}</span>
                </li>
              ))
            }
          </ul>
          <div class="after">
            <a class="go" href={RESUME_URL} rel="noopener" target="_blank"
              ><span class="u">The full resume</span> <span class="arr"><Icon icon={ArrowUpRight01Icon} /></span></a
            >
          </div>
        </div>
        <div class="list edu">
          <p class="lead">What I've studied</p>
          <ul>
            {
              EDUCATION.map((item) => (
                <li>
                  <b>{item.name}</b>
                  <span class="d">{item.when}</span>
                  <span class="r">{item.note}</span>
                </li>
              ))
            }
          </ul>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
