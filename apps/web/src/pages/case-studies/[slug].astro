---
import { ArrowLeft01Icon, ArrowRight01Icon, ArrowUpRight01Icon } from "@hugeicons/core-free-icons";
import Icon from "../../components/site/icon.astro";
import MediaSlot from "../../components/site/media-slot.astro";
import BaseLayout from "../../layouts/base-layout.astro";
import { getGraft } from "../../lib/graft";
import { storyOf, toCaseStudy } from "../../lib/portfolio";

export const prerender = true;

export const getStaticPaths = async () => {
  const documents = await getGraft().listContent("case-studies");

  return documents.map((document) => ({
    params: { slug: document.slug },
  }));
};

const { slug } = Astro.params;
const graft = getGraft();
const document = slug ? await graft.getContent("case-studies", slug) : null;

if (!(document && slug)) {
  throw new Error(
    `Case study "${slug ?? "(missing slug)"}" is missing from the Graft index.`
  );
}

const study = toCaseStudy(document);
const story = storyOf(study);


const allStudies = await graft.listContent("case-studies");

const studies = allStudies.toSorted(
  (left, right) => left.data.order - right.data.order
);

// The next study, wrapping round to the first.
const index = studies.findIndex((entry) => entry.slug === slug);
const nextEntry = studies.length > 1 ? studies[(index + 1) % studies.length] : null;

const next = nextEntry
  ? { slug: nextEntry.slug, title: storyOf(toCaseStudy(nextEntry)).title }
  : null;

// The first sentence of "why" is set in bold.
const whyBreak = story.why.search(/[.!?]\s/u);
const whyLead = whyBreak === -1 ? story.why : story.why.slice(0, whyBreak + 1);
const whyRest = whyBreak === -1 ? "" : story.why.slice(whyBreak + 1);

const heroMedia = story.media?.find((entry) => entry.slot === "hero");
const stepsMedia = story.media?.find((entry) => entry.slot === "steps");

const heroFallback = study.hero.heroImage
  ? { alt: study.gallery.images[0]?.alt ?? story.title, src: study.hero.heroImage }
  : undefined;

const galleryImages = study.gallery.images.filter((image) => Boolean(image.src));
const weeks = story.steps.every((step) => step.weeks) ? story.steps : null;
const textual = (value: string) => !/^\d/u.test(value.trim());
const live = study.hero.liveUrl ? new URL(study.hero.liveUrl) : null;
---

<BaseLayout
  description={story.overview}
  og={{ client: study.hero.client, kind: "case-study", title: story.title }}
  title={`${story.title}: a case study`}
>
  <article class="wrap">
    <a class="cs-back" href="/projects"><span class="arr"><Icon icon={ArrowLeft01Icon} /></span> All my work</a>
    <header class="cs-head field12">
      <h1>{story.title}</h1>
      <p class="ov">{story.overview}</p>
      <div class="cs-meta">
        <span>{study.hero.client}</span>
        <span>{story.when}</span>
        {
          live && (
            <a class="u" href={live.href} rel="noopener" target="_blank">
              {live.hostname.replace(/^www\./u, "")} <span class="arr"><Icon icon={ArrowUpRight01Icon} /></span>
            </a>
          )
        }
      </div>
    </header>

    {
      heroMedia ? (
        <MediaSlot fallback={heroFallback} media={heroMedia} />
      ) : heroFallback ? (
        <div class="fig" style="--ar: 16 / 9">
          <img alt={heroFallback.alt} decoding="async" fetchpriority="high" src={heroFallback.src} />
        </div>
      ) : null
    }

    <div class="sec">
      <div class="cs-why field12">
        <p><b>{whyLead}</b>{whyRest}</p>
      </div>
    </div>

    <section aria-label="Before and after" class="ba" data-ba data-v="before">
      <div class="ba-top">
        <p>{story.compare}</p>
        <div aria-label="Show numbers from" class="seg" role="group">
          <span aria-hidden="true" class="thumb"></span>
          <button aria-pressed="true" data-v="before" type="button">Before</button>
          <button aria-pressed="false" data-v="after" type="button">After</button>
        </div>
      </div>
      <div class="stats">
        {
          story.stats.map((stat) => (
            <div class="stat">
              <span class="k">{stat.label}</span>
              <div
                class:list={["v", { txt: textual(stat.before) || textual(stat.after) }]}
                data-after={stat.after}
                data-before={stat.before}
              >
                <span>{stat.before}</span>
              </div>
              <span class="d">{stat.note}</span>
            </div>
          ))
        }
      </div>
      {story.extra && <p class="extra">{story.extra}</p>}
    </section>

    <section aria-label="How it went" class="sec">
      {
        weeks && (
          <div aria-hidden="true" class="weeks" data-weeks>
            {weeks.map((step) => (
              <div style={`flex: ${step.weeks}`}>
                <i />
                <span>
                  {step.name}, {step.weeks} wk
                </span>
              </div>
            ))}
          </div>
        )
      }
      <div class="steps">
        <nav aria-label="Steps" class="rail" data-line="0.5" data-rail=".step">
          {
            story.steps.map((step, stepIndex) => (
              <button class:list={["rail-btn", { on: stepIndex === 0 }]} type="button">
                <i />
                {step.name}
              </button>
            ))
          }
        </nav>
        <div>
          {
            story.steps.map((step) => (
              <div class="step">
                {step.when && <span class="when">{step.when}</span>}
                <h2>{step.heading}</h2>
                <p>{step.body}</p>
              </div>
            ))
          }
          {
            stepsMedia && (
              <div class="steps-media">
                <MediaSlot fallback={study.gallery.images[1]} media={stepsMedia} />
              </div>
            )
          }
        </div>
      </div>
    </section>

    {
      galleryImages.length > 0 && (
        <section aria-label="Pictures" class="sec">
          <div class="gal-viewer" data-gallery tabindex="-1">
            <div class="gal-bar">
              <div class="gal-meta">
                <p class="gal-cap" data-gal-cap>{galleryImages[0]?.title}</p>
                {galleryImages.length > 1 && (
                  <span class="small tnum" data-gal-count>
                    1 / {galleryImages.length}
                  </span>
                )}
              </div>
              {galleryImages.length > 1 && (
                <div class="gal-nav">
                  <button aria-label="Previous image" data-gal-step="-1" type="button">
                    <Icon icon={ArrowLeft01Icon} />
                  </button>
                  <button aria-label="Next image" data-gal-step="1" type="button">
                    <Icon icon={ArrowRight01Icon} />
                  </button>
                </div>
              )}
            </div>
            <div class="gal-stage">
              {
                galleryImages.map((image, imageIndex) => (
                  <figure class="gal-slide" data-gal-slide hidden={imageIndex !== 0}>
                    <div class="fig" style="--ar: 16 / 10">
                      <img alt={image.alt} decoding="async" loading="lazy" src={image.src} />
                    </div>
                    <figcaption class="sr-only">{image.title}</figcaption>
                  </figure>
                ))
              }
              {galleryImages.length > 1 && (
                <>
                  <button
                    aria-label="Previous image"
                    class="gal-arrow prev"
                    data-gal-step="-1"
                    type="button"
                  >
                    <Icon icon={ArrowLeft01Icon} size={18} />
                  </button>
                  <button
                    aria-label="Next image"
                    class="gal-arrow next"
                    data-gal-step="1"
                    type="button"
                  >
                    <Icon icon={ArrowRight01Icon} size={18} />
                  </button>
                </>
              )}
            </div>
            {galleryImages.length > 1 && (
              <div aria-label="Choose image" class="gal-thumbs" role="tablist">
                {
                  galleryImages.map((image, imageIndex) => (
                    <button
                      aria-label={image.title}
                      aria-selected={imageIndex === 0 ? "true" : "false"}
                      class:list={["gal-thumb", { on: imageIndex === 0 }]}
                      data-gal-pick={imageIndex}
                      role="tab"
                      type="button"
                    >
                      <img alt="" decoding="async" loading="lazy" src={image.src} />
                    </button>
                  ))
                }
              </div>
            )}
          </div>
        </section>
      )
    }

    {
      next && (
        <a class="cs-next" href={`/case-studies/${next.slug}`}>
          <span class="small">Read next</span>
          <b>
            {next.title} <span class="arr"><Icon icon={ArrowRight01Icon} /></span>
          </b>
        </a>
      )
    }
  </article>
</BaseLayout>
