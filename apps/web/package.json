{
  "name": "@andy-portfolio/web",
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "astro": "astro",
    "build": "bun run --filter=@andy-portfolio/content compile && astro build",
    "check": "ultracite check",
    "dev": "bun run --filter=@andy-portfolio/content compile && astro dev --port 3000 --host",
    "fix": "ultracite fix",
    "graft:compile": "bun run --filter=@andy-portfolio/content compile",
    "graft:dev": "bun run --filter=@andy-portfolio/content graft:dev",
