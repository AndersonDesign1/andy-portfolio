{
  "name": "@andy-portfolio/web-next",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "bun run --filter=@andy-portfolio/content compile && next build",
    "check": "biome check .",
    "dev": "bun run --filter=@andy-portfolio/content compile && next dev -p 3001",
    "fix": "biome check --write .",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "biome check --write --no-errors-on-unmatched"
    ]
  },
  "overrides": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0"
  },
  "dependencies": {
    "@andy-portfolio/content": "workspace:*",
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@react-email/components": "^1.0.12",
    "@react-email/tailwind": "^2.0.3",
    "@usegraft/core": "^1.0.0-beta.9",
    "@usegraft/db": "^1.0.0-beta.9",
    "@usegraft/sdk-next": "^1.0.0-beta.9",
    "@vercel/analytics": "^1.4.1",
    "@vercel/speed-insights": "^1.1.0",
    "botid": "^1.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lenis": "^1.3.27",
    "motion": "^14.12.0",
    "next": "16.4.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-email": "^6.11.11",
    "react-hook-form": "^7.92.0",
    "react-is": "19.3.1",
    "resend": "^6.38.0",
    "shadcn-ui": "^0.9.4",
    "sonner": "^2.0.7",
    "styled-components": "^6.6.0",
    "swr": "^2.4.2",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@next/bundle-analyzer": "16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/node": "22.10.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lint-staged": "^16.2.7",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.8.2",
    "ultracite": "7.10.3"
  },
  "engines": {
    "node": "22.x"
  }
}
