{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // Nested config: Biome 2.x discovers this from the repo root, so it must
  // declare `root: false` or it breaks the root run.
  "root": false,
  // `ultracite/core|react|next` are the *oxlint* presets and have no Biome
  // export — leaving them here made every root Biome run fail with
  // "Could not resolve ultracite/core". Only the `ultracite/biome/*` presets
  // are valid for Biome.
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ]
}
