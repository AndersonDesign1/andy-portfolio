{
  "name": "@andy-portfolio/ai-tutor",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/tutor.ts",
    "./budget": "./src/budget.ts",
    "./postgres-budget": "./src/postgres-budget.ts",
    "./models": "./src/models.ts",
    "./prompts": "./src/prompts.ts",
    "./route": "./src/route.ts"
  },
  "scripts": {
    "conversations": "bun --env-file=../../.env.local --env-file=.env.local run src/conversation-test.ts",
    "fallbacks": "bun --env-file=../../.env.local --env-file=.env.local run src/fallback-test.ts",
    "budget": "bun --env-file=../../.env.local --env-file=.env.local run src/budget-test.ts",
    "scope": "bun --env-file=../../.env.local --env-file=.env.local run src/scope-test.ts",
    "timeouts": "bun run src/timeout-test.ts",
    "unit": "bun run src/unit-test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --config oxlint.config.mts .",
    "lint:fix": "oxlint --config oxlint.config.mts --fix ."
  },
  "dependencies": {
    "@neon/ai-sdk-provider": "^1.4.0",
    "@neondatabase/serverless": "^1.2.1",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "ai": "^7.0.179",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@neon/config": "^1.14.6",
    "@types/bun": "^1.4.5",
    "oxlint": "1.94.0"
  }
